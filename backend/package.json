{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Call calendar backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc",
    "test": "vitest run",
    "generate": "NODE_OPTIONS='--import ./typescript6-for-hey-api.mjs' openapi-ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "fastify-openapi-glue": "^4.12.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^24.19.2",
    "@typescript/typescript6": "^6.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "^4.3.2"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
