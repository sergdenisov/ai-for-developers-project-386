{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // spec, backend and frontend are separate packages, each checked with `knip --directory` against its own config.
  "ignore": ["backend/**", "frontend/**", "spec/**"],
  // Run by hk (hk.pkl), which Knip does not read.
  "ignoreDependencies": ["oxfmt", "oxlint"]
}
