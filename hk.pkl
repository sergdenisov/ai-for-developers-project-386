amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"

// Generated by Hexlet; the course forbids editing it.
local hexletWorkflow = ".github/workflows/hexlet-check.yml"

// Fast checks on changed files. Knip is not here: its builtin runs `knip --fix`,
// which deletes code; it runs through `mise run check:project` instead.
local linters = new Mapping<String, Step> {
  ["oxfmt"] = (Builtins.oxfmt) {
    // Markdown is formatted by rumdl.
    exclude = List("**/*.md", "**/package-lock.json", hexletWorkflow)
  }
  ["oxlint"] = (Builtins.ox_lint) {
    check = "oxlint --deny-warnings --report-unused-disable-directives {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "commitlint --edit {{commit_msg_file}}"
      }
    }
  }
  ["pre-push"] {
    steps {
      ...linters
      ["project"] {
        check = "mise run check:project"
        exclusive = true
      }
    }
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}
