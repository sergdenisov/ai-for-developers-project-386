{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true
  },
  // Exception, human decision in https://github.com/sergdenisov/ai-for-developers-project-386/issues/18:
  // generated by @hey-api/openapi-ts; regenerated and diff-checked by `check:contract`.
  "ignorePatterns": ["frontend/src/api/generated/**", "backend/src/api/generated/**"],
  "rules": {
    // The frontend uses the automatic JSX runtime ("jsx": "react-jsx"), so React does not need to be in scope.
    "react/react-in-jsx-scope": "off",
    // Side-effect imports are allowed only for stylesheets (Mantine styles).
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
  },
  "overrides": [
    {
      "files": ["frontend/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Call the API through the generated SDK in src/api/generated."
          }
        ]
      }
    }
  ]
}
